# ==============================================================================
# WELELE MEDIA™ — LOCAL / DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions: Copy to .env.local for local machine execution.
# Sensitive credentials must NEVER be committed to version control.

# Application Environment
ENVIRONMENT=development
APP_ENV=development
NODE_ENV=development
ENABLE_STARTUP_SEED=true

# Public API & Supabase (Dev Instance)
NEXT_PUBLIC_SUPABASE_URL=https://dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...dev_anon_key_placeholder...
SUPABASE_URL=https://dev-project.supabase.co
SUPABASE_KEY=eyJhbGciOi...dev_service_role_key_placeholder...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...dev_service_role_key_placeholder...

# Local Dev Ports
PORT=8000
VITE_API_URL=http://localhost:8000/api

# Cloudflare R2 / Dev Storage
CDN_BASE_URL=http://localhost:8000/media
STORAGE_BUCKET=welele-vod-dev
R2_ACCOUNT_ID=dev_r2_account_placeholder
R2_ACCESS_KEY_ID=dev_r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=dev_r2_secret_key_placeholder
R2_BUCKET_NAME=welele-vod-dev

# AI Reasoning & Story Forge
GEMINI_API_KEY=dev_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash
STORY_FORGE_LLM_MODEL=gemini-1.5-flash
STORY_FORGE_LLM_PROVIDER=gemini
STORY_FORGE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Admin Authentication (Explicitly supplied via environment config; never hardcoded)
ADMIN_MASTER_KEY=dev_admin_master_key_placeholder
ADMIN_2FA_CODE=dev_2fa_code_placeholder
