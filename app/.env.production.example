# ==============================================================================
# WELELE MEDIA™ — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Target: Cloudflare Pages / Edge + High-Availability Container + Supabase Enterprise
# STRICT POLICY: Production credentials must NEVER exist on developer local machines.

# Application Environment
ENVIRONMENT=production
APP_ENV=production
NODE_ENV=production
ENABLE_STARTUP_SEED=false

# Supabase Production Project (Isolated DB Instance)
NEXT_PUBLIC_SUPABASE_URL=https://prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...prod_anon_key_placeholder...
SUPABASE_URL=https://prod-project.supabase.co
SUPABASE_KEY=eyJhbGciOi...prod_service_role_key_placeholder...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...prod_service_role_key_placeholder...

# Public URLs
PORT=8000
VITE_API_URL=https://api.welele.media/api
FRONTEND_URL=https://welele.media

# Cloudflare R2 Production Object Storage
CDN_BASE_URL=https://cdn.welele.media
STORAGE_BUCKET=welele-vod-masters
R2_ACCOUNT_ID=prod_r2_account_placeholder
R2_ACCESS_KEY_ID=prod_r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=prod_r2_secret_key_placeholder
R2_BUCKET_NAME=welele-vod-masters

# AI Reasoning & Story Forge (Production Quota Tier)
GEMINI_API_KEY=prod_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash
STORY_FORGE_LLM_MODEL=gemini-1.5-flash
STORY_FORGE_LLM_PROVIDER=gemini
STORY_FORGE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
