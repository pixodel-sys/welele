# ==============================================================================
# WELELE MEDIA™ — STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
# Target: Cloudflare Pages (Frontend) + Railway/Container (Backend) + Supabase Staging
# Never mix staging keys with production credentials.

# Application Environment
ENVIRONMENT=staging
APP_ENV=staging
NODE_ENV=production
ENABLE_STARTUP_SEED=false

# Supabase Staging Project
NEXT_PUBLIC_SUPABASE_URL=https://staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...staging_anon_key_placeholder...
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_KEY=eyJhbGciOi...staging_service_role_key_placeholder...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...staging_service_role_key_placeholder...

# Public URLs
PORT=8000
VITE_API_URL=https://api-staging.welele.media/api
FRONTEND_URL=https://staging.welele.media

# Cloudflare R2 Staging Bucket
CDN_BASE_URL=https://cdn-staging.welele.media
STORAGE_BUCKET=welele-vod-staging
R2_ACCOUNT_ID=staging_r2_account_placeholder
R2_ACCESS_KEY_ID=staging_r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=staging_r2_secret_key_placeholder
R2_BUCKET_NAME=welele-vod-staging

# AI Reasoning & Story Forge
GEMINI_API_KEY=staging_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash
STORY_FORGE_LLM_MODEL=gemini-1.5-flash
STORY_FORGE_LLM_PROVIDER=gemini
STORY_FORGE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
